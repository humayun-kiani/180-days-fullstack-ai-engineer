# ============================================================
# PRODUCTION ENVIRONMENT — Store securely, NEVER commit!
# On server: /home/appuser/taskmanager/.env
# ============================================================

ENVIRONMENT=production
DEBUG=false
APP_NAME="Task Manager API"
APP_VERSION="1.0.0"

# Database — use strong passwords!
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=taskmanager_prod
POSTGRES_USER=taskuser_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Redis
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Auth — MUST be long random string, never reuse dev key!
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_HEX_STRING

# CORS — your actual frontend domain
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# HTTPS — your actual domain
ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com

# Nginx and Let's Encrypt
DOMAIN=api.yourdomain.com
EMAIL=your@email.com    # for SSL cert notifications

# Workers
WEB_CONCURRENCY=4       # usually 2 * CPU cores